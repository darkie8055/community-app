# No .env file is needed for npm run web. Fill these values only for real services.
# Copy to .env at the repository root. Empty values must be filled by the operator.
# APP_MODE=live forces real services; demo commands override it for their own process.
# Only API_BASE_URL / Firebase client options enter client builds.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8080,http://localhost:8080

# Server only. Separate database-owner and restricted runtime identities.
DATABASE_URL=
MIGRATION_DATABASE_URL=
JWT_SECRET=
REDIS_URL=
FCM_ENABLED=true
FIREBASE_PROJECT_ID=
# Local ADC service-account file path, relative to root or absolute. Never bundle this file.
# Keep local private credential files under .local/credentials/ (ignored by Git and Docker).
# On AWS use workload identity / application default credentials where configured.
GOOGLE_APPLICATION_CREDENTIALS=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Omit AWS keys when the server uses an IAM role.

# One-time bootstrap account. Remove ADMIN_PASSWORD after create-admin succeeds.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Public endpoints. Native phones require a reachable LAN or HTTPS server URL.
API_BASE_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/v1

# Public Firebase client configuration; use apps belonging to FIREBASE_PROJECT_ID above.
FIREBASE_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_RESIDENT_APP_ID=
FIREBASE_ANDROID_GUARD_APP_ID=
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_RESIDENT_APP_ID=
FIREBASE_IOS_GUARD_APP_ID=
FIREBASE_IOS_RESIDENT_BUNDLE_ID=com.myhome.resident
FIREBASE_IOS_GUARD_BUNDLE_ID=com.myhome.guard

# Optional local PostgreSQL container. Supply your own password; no database is seeded.
POSTGRES_PASSWORD=

# Optional local iOS signing. Configure release signing through EAS credentials.
APPLE_DEVELOPMENT_TEAM=
EAS_RESIDENT_PROJECT_ID=
EAS_GUARD_PROJECT_ID=

# Firebase console > iOS app > Encoded App ID (URL scheme for phone verification).
FIREBASE_IOS_RESIDENT_URL_SCHEME=
FIREBASE_IOS_GUARD_URL_SCHEME=
