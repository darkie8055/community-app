# Copy to apps/api/.env. Do not enable demonstration identities in production.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8080,http://localhost:8080
DB_MODE=embedded
PGLITE_PATH=../../.local/postgres
# For native PostgreSQL: DB_MODE=postgres and set these separate URLs.
DATABASE_URL=postgresql://mycommunity_app:local_app_password@127.0.0.1:5432/mycommunity
MIGRATION_DATABASE_URL=postgresql://postgres:local_admin_password@127.0.0.1:5432/mycommunity
JWT_SECRET=replace-with-at-least-32-random-characters
DEMO_MODE=true
SEED_DEMO=true
REDIS_URL=
# Set REDIS_URL=redis://127.0.0.1:6379 after starting docker compose.
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
# Standard AWS SDK credentials: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
